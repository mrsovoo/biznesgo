{
  "name": "biznesgo",
  "version": "1.0.0",
  "description": "Telegram dori qo'shish boti va Admin Panel (Neon PostgreSQL + Render)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build:client": "cd client && npm install && npm run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.34.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
